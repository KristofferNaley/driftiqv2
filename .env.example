# Kopier til .env og fyll inn. .env committes ALDRI — se .gitignore.

# Eier av skjemaet. Rollen MÅ ha BYPASSRLS: admin-laget (migrasjoner, plattformpanel,
# bakgrunnsjobber) er avhengig av å omgå policyene, og FORCE gjelder også eieren.
# Verten «postgres» er den sentrale Postgres 17-serveren på edge-nettet.
DATABASE_URL=postgresql://driftiq_v2:BYTT_MEG@postgres:5432/driftiq_v2

# Appens ikke-eiende rolle. Opprettes automatisk ved oppstart med dette passordet.
# I motsetning til v1 er den PÅKREVD: uten den nekter appen å starte i stedet for å
# falle tilbake til eierrollen og kjøre videre uten reell tenantisolasjon.
APP_DB_USER=driftiq_v2_app
APP_DB_PASSWORD=BYTT_MEG

# Better Auth. Generer med: openssl rand -hex 32
BETTER_AUTH_SECRET=BYTT_MEG
BETTER_AUTH_URL=http://localhost:3008
# Andre verter appen nås fra, kommaseparert. Uten disse svarer innlogging 403
# INVALID_ORIGIN fra alt annet enn BETTER_AUTH_URL — f.eks. fra en telefon på samme nett.
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.158:3008

# Rot for opplastede filer. Strukturen er uploads/orgs/{orgId}/<modul>/…
UPLOAD_DIR=/app/uploads

# ── RESEND (utgående e-post) ────────────────────────────────────────────────────────────
# Passordreset, velkomst til nye brukere og (senere) varsler. Nøkkel fra resend.com.
# Er den TOM, sendes ingenting og appen kjører videre — et manglende varsel skal aldri
# velte en handling brukeren utførte.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# Avsender. Domenet MÅ være verifisert i Resend, ellers avvises sendingen.
FROM_EMAIL=DriftIQ <noreply@driftiq.no>

# Domenet lenkene i e-postene peker til. Settes feil, får brukeren en lenke som ikke virker.
BASE_URL=http://192.168.1.158:3008

# ── DOMENEVAKT ──────────────────────────────────────────────────────────────────────────
# Kommaseparert. Med @ = nøyaktig adresse, uten @ = hele domenet:
#
#     EPOST_TILLATTE_DOMENER=driftiq.no,meg@gmail.com
#
# SETT DENNE I TEST. Testbasen er en kopi av produksjon og inneholder ekte, leverbare
# adresser — uten vakten sender testmiljøet ekte e-post til ekte mennesker.
#
# Vakten er AV når variabelen ikke er satt. Det er med vilje: produksjon skal ikke være
# avhengig av at noen husker å konfigurere den. Den skrus PÅ i test, ikke av i prod.
EPOST_TILLATTE_DOMENER=

# RESERVE for lead- og feilmeldingsvarsler. Mottakerne konfigureres i plattformpanelet
# (Prismodell → varselmottakere); denne brukes bare når den lista er tom — slik det var
# før lista fantes. Se plattformVarslingsadresser() i src/lib/prismodell.ts. Er begge
# tomme, lagres leaden fortsatt, men ingen får beskjed — og det logges høyt.
LEADS_NOTIFY_EMAIL=deg@example.no

# ── VERTSDELING ─────────────────────────────────────────────────────────────────────────
# Tre domener mot samme app: markedsside, kunde-app og plattformpanel. Rutene som ikke
# hører hjemme på en vert svarer 404 DER — en kompromittert kundesesjon kan ikke nå
# panelet, fordi panelet ikke finnes på kundeverten.
#
# Er alle tomme, serveres alt på én vert. Det er standarden, og det er slik lokal
# utvikling og tilgang via IP-adresse virker.
#
# Husk at hver vert MÅ stå i BETTER_AUTH_TRUSTED_ORIGINS, ellers avvises innlogging der.
VERT_MARKED=
VERT_APP=
VERT_ADMIN=

# ── DISCORD-DRIFTSVARSLER ───────────────────────────────────────────────────────────────
# Webhook for varsler til driftsansvarlig (IKKE til kunder): appen startet (= deploy eller
# restart) og bakgrunnsjobber som feiler. Lages i Discord: Server Settings → Integrations →
# Webhooks. URL-en er en hemmelighet — alle som har den kan poste i kanalen.
# Er den TOM, sendes ingenting og appen kjører videre. Nedetid varsles ikke herfra (en død
# app sender ingenting); det gjør Uptime Kuma, som overvåker /api/health utenfra.
# Meldingene prefikses med vertsnavnet fra BASE_URL, så prod og test kan dele kanal.
DISCORD_WEBHOOK_URL=

# ── ANTHROPIC ───────────────────────────────────────────────────────────────────────────
# AI-rådgiver — nøkkel fra console.anthropic.com. Uten den svarer /ai/ask 503 og siden sier
# at rådgiveren ikke er konfigurert; resten av appen kjører upåvirket.
ANTHROPIC_API_KEY=sk-ant-...

# Kurs USD → NOK for å vise AI-forbruk i kroner i plattformpanelet. Kun et estimat —
# fasit er fakturaen fra Anthropic.
USD_TIL_NOK=11.0

# ── WEBANALYSE (UMAMI) ──────────────────────────────────────────────────────────────────
# Selvhostet, cookieløs statistikk. Umami er IKKE en del av denne stacken — den kjører som
# egen stack (~/umami på VPS-en) og nås på det delte `edge`-nettet. Kun prod: lokalt og i
# test finnes den ikke, og da skal begge ID-ene stå tomme.
#
# Skriptet serveres FØRSTEPARTS via /stats/ (proxy i src/app/stats/[...sti]/route.ts) —
# et tredjeparts stats.driftiq.no-skript blokkeres av uBlock, Brave og Safari på et
# flertall av besøkene, og da måler du bare dem som ikke blokkerer.
#
# Én ID per flate, opprettet i Umami-dashbordet (stats.driftiq.no → Settings → Websites).
# Landingssiden og appen holdes atskilt: «hvem fant oss» og «hva brukes» er to ulike
# spørsmål. Plattformpanelet har bevisst ingen — vi skal ikke måle oss selv.
# Er en ID tom, legges ingen skripttagg inn i det hele tatt.
UMAMI_URL=http://umami:3000
UMAMI_NETTSTED_MARKED=
UMAMI_NETTSTED_APP=
