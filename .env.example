# Kopier til .env og fyll inn. .env committes ALDRI — se .gitignore.

# Eier av skjemaet. Rollen MÅ ha BYPASSRLS: admin-laget (migrasjoner, plattformpanel,
# bakgrunnsjobber) er avhengig av å omgå policyene, og FORCE gjelder også eieren.
# Verten «postgres» er den sentrale Postgres 17-serveren på edge-nettet.
DATABASE_URL=postgresql://driftiq_v2:BYTT_MEG@postgres:5432/driftiq_v2

# Appens ikke-eiende rolle. Opprettes automatisk ved oppstart med dette passordet.
# I motsetning til v1 er den PÅKREVD: uten den nekter appen å starte i stedet for å
# falle tilbake til eierrollen og kjøre videre uten reell tenantisolasjon.
APP_DB_USER=driftiq_v2_app
APP_DB_PASSWORD=BYTT_MEG

# Better Auth. Generer med: openssl rand -hex 32
BETTER_AUTH_SECRET=BYTT_MEG
BETTER_AUTH_URL=http://localhost:3008
# Andre verter appen nås fra, kommaseparert. Uten disse svarer innlogging 403
# INVALID_ORIGIN fra alt annet enn BETTER_AUTH_URL — f.eks. fra en telefon på samme nett.
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.158:3008

# Rot for opplastede filer. Strukturen er uploads/orgs/{orgId}/<modul>/…
UPLOAD_DIR=/app/uploads

# ── RESEND (utgående e-post) ────────────────────────────────────────────────────────────
# Passordreset, velkomst til nye brukere og (senere) varsler. Nøkkel fra resend.com.
# Er den TOM, sendes ingenting og appen kjører videre — et manglende varsel skal aldri
# velte en handling brukeren utførte.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# Avsender. Domenet MÅ være verifisert i Resend, ellers avvises sendingen.
FROM_EMAIL=DriftIQ <noreply@driftiq.no>

# Domenet lenkene i e-postene peker til. Settes feil, får brukeren en lenke som ikke virker.
BASE_URL=http://192.168.1.158:3008

# ── DOMENEVAKT ──────────────────────────────────────────────────────────────────────────
# Kommaseparert. Med @ = nøyaktig adresse, uten @ = hele domenet:
#
#     EPOST_TILLATTE_DOMENER=driftiq.test,meg@gmail.com
#
# SETT DENNE I TEST. Testbasen er en kopi av produksjon og inneholder ekte, leverbare
# adresser — uten vakten sender testmiljøet ekte e-post til ekte mennesker.
#
# Vakten er AV når variabelen ikke er satt. Det er med vilje: produksjon skal ikke være
# avhengig av at noen husker å konfigurere den. Den skrus PÅ i test, ikke av i prod.
EPOST_TILLATTE_DOMENER=
