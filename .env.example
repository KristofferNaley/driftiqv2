# Kopier til .env og fyll inn. .env committes ALDRI — se .gitignore.

# Eier av skjemaet. Rollen MÅ ha BYPASSRLS: admin-laget (migrasjoner, plattformpanel,
# bakgrunnsjobber) er avhengig av å omgå policyene, og FORCE gjelder også eieren.
# Verten «postgres» er den sentrale Postgres 17-serveren på edge-nettet.
DATABASE_URL=postgresql://driftiq_v2:BYTT_MEG@postgres:5432/driftiq_v2

# Appens ikke-eiende rolle. Opprettes automatisk ved oppstart med dette passordet.
# I motsetning til v1 er den PÅKREVD: uten den nekter appen å starte i stedet for å
# falle tilbake til eierrollen og kjøre videre uten reell tenantisolasjon.
APP_DB_USER=driftiq_v2_app
APP_DB_PASSWORD=BYTT_MEG

# Better Auth. Generer med: openssl rand -hex 32
BETTER_AUTH_SECRET=BYTT_MEG
BETTER_AUTH_URL=http://localhost:3008
